# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=hibrid-rag
CLOUD_TASKS_LOCATION=southamerica-east1

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima

# Pub/Sub Topics (padrão - serão substituídos por topics específicos por cliente)
# Formato: {nome_cliente}-processamento e {nome_cliente}-envio
# Exemplo: hubnordeste-processamento, hubnordeste-envio
# Padrão: default-processamento, default-envio

# Cloud Run URLs (exemplos)
MESSAGE_BUFFER_URL=https://message-buffer-xxxxx-sae1.run.app
MESSAGE_PROCESSOR_URL=https://message-processor-xxxxx-sae1.run.app
MESSAGE_DELIVERY_URL=https://message-delivery-xxxxx-sae1.run.app

# RAG Configuration
RAG_SERVER_URL=https://rag-server-xxxxx-sae1.run.app
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Development
DEBUG=true
LOG_LEVEL=INFO
