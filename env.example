# ========================================
# Configuração do Projeto Hibrid RAG
# ========================================

# Google Cloud
GOOGLE_PROJECT_ID=seu-projeto-gcp
CLOUD_TASKS_QUEUE_ID=message-processing-queue
CLOUD_TASKS_LOCATION=us-central1

# Pub/Sub Topics
PUBSUB_TOPIC_TO_PROCESS=para-processamento
PUBSUB_TOPIC_TO_SEND=para-envio

# URLs das Cloud Functions
MESSAGE_BUFFER_URL=https://us-central1-seu-projeto-gcp.cloudfunctions.net/message-buffer

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima

# CRM APIs
WTS_API_TOKEN=seu-token-wts
KOMMO_API_TOKEN=seu-token-kommo
RD_API_TOKEN=seu-token-rd

# Configurações de Desenvolvimento
DEBUG=true
LOG_LEVEL=INFO
