# Message Processor - Cloud Function
FROM python:3.11-slim

# Definir variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Criar diretório de trabalho
WORKDIR /app

# Copiar requirements primeiro (para cache)
COPY requirements.txt requirements.txt

# Instalar dependências Python
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copiar código da função
COPY message_processor_*.py ./
COPY classes/ ./classes/
COPY service-account.json ./

# Verificar se message_processor_main.py existe
RUN test -f message_processor_main.py || (echo "message_processor_main.py não encontrado!" && exit 1)

# Expor porta
EXPOSE 8080

# Comando para executar a função (especificando o arquivo correto)
CMD exec python -m functions_framework --target=message_processor --port=8080 --host=0.0.0.0 --source=message_processor_main.py